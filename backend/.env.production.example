APP_NAME=Jelajahin
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:REPLACE_WITH_PHP_ARTISAN_KEY_GENERATE_SHOW
APP_URL=https://your-backend-domain.up.railway.app

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

DB_CONNECTION=pgsql
# On Railway or Render, attach a PostgreSQL database so DATABASE_URL is injected automatically:
DATABASE_URL=postgresql://postgres:password@host:5432/jelajahin_website
DB_SSLMODE=prefer

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# "auto" seeds demo data once on an empty database:
AUTO_SEED=auto
